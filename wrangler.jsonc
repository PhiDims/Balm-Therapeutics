// Cloudflare Worker settings for balmtherapeutics.com.ng
{
  "name": "balm-therapeutics",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "keep_vars": true,
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
