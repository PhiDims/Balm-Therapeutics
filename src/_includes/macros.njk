{# Reusable pieces. Import with: {% import "macros.njk" as m %} #}

{% macro icon(name, size=22, color="currentColor", sw=2) -%}
<svg aria-hidden="true" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="{{ color }}" stroke-width="{{ sw }}" stroke-linecap="round" stroke-linejoin="round">
{%- if name == "whatsapp" %}<path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.4A8.4 8.4 0 1 1 21 11.5z"/><path d="M9 9.5c.3 2 2.3 4.1 4.5 4.6"/>
{%- elif name == "phone" %}<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>
{%- elif name == "mail" %}<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>
{%- elif name == "pin" %}<path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>
{%- elif name == "clock" %}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
{%- elif name == "lock" %}<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>
{%- elif name == "arrow" %}<path d="M5 12h14M13 6l6 6-6 6"/>
{%- elif name == "chevron" %}<path d="M6 9l6 6 6-6"/>
{%- elif name == "check" %}<path d="M5 12.5l4.5 4.5L19 7"/>
{%- elif name == "alert" %}<path d="M12 3l9.5 17h-19z"/><path d="M12 10v4M12 17.5v.01"/>
{%- elif name == "person" %}<circle cx="12" cy="8" r="4"/><path d="M4 21c1.2-4 4.3-6 8-6s6.8 2 8 6"/>
{%- elif name == "child" %}<circle cx="9" cy="7" r="3"/><circle cx="17" cy="10" r="2.2"/><path d="M3 20c.8-3.4 3.2-5.5 6-5.5s5.2 2.1 6 5.5"/><path d="M14.5 15.5c.7-.6 1.6-1 2.5-1 2 0 3.5 1.6 4 4"/>
{%- elif name == "heart" %}<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>
{%- elif name == "building" %}<path d="M3 21h18"/><path d="M5 21V10l7-5 7 5v11"/><path d="M10 21v-5h4v5"/>
{%- elif name == "shield" %}<path d="M12 3l7 3v6c0 4.4-3 7.7-7 9-4-1.3-7-4.6-7-9V6z"/>
{%- elif name == "download" %}<path d="M12 4v11M7 10l5 5 5-5"/><path d="M5 20h14"/>
{%- elif name == "camera" %}<path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/>
{%- elif name == "map" %}<path d="M9 4L3 6v14l6-2 6 2 6-2V4l-6 2z"/><path d="M9 4v14M15 6v14"/>
{%- elif name == "menu" %}<path d="M4 7h16M4 12h16M4 17h16"/>
{%- elif name == "close" %}<path d="M6 6l12 12M18 6L6 18"/>
{%- endif -%}
</svg>
{%- endmacro %}

{% macro squiggle(pos="left: -80px; bottom: -40px; width: 520px; height: 260px", color="#FFD9C4", shape="a") -%}
{%- if shape == "b" -%}
<svg class="squiggle" aria-hidden="true" viewBox="0 0 400 400" style="{{ pos }}"><path d="M40 360 C 20 220, 160 260, 150 150 S 280 40, 360 120 S 330 300, 390 330" stroke="{{ color }}"/></svg>
{%- else -%}
<svg class="squiggle" aria-hidden="true" viewBox="0 0 600 300" style="{{ pos }}"><path d="M10 250 C 90 120, 170 300, 250 170 S 380 40, 430 140 S 560 260, 590 90" stroke="{{ color }}"/></svg>
{%- endif -%}
{%- endmacro %}

{% macro photo(note, src="", alt="", cls="ph-photo") -%}
{%- if src -%}<img class="photo" src="{{ src }}" alt="{{ alt }}" loading="lazy">
{%- else -%}<div class="ph {{ cls }}" role="img" aria-label="Photo to come: {{ note }}">{{ icon("camera", 36, "currentColor", 1.6) | safe }}<span>{{ note }}</span></div>{%- endif -%}
{%- endmacro %}

{% macro portrait(person, alt=false, cls="") -%}
<div class="portrait {{ 'alt' if alt }} {{ cls }}">
{%- if person.data.photo -%}<img class="photo-img" src="{{ person.data.photo }}" alt="Portrait of {{ person.data.name }}" loading="lazy">
{%- else -%}<img class="mark" src="/assets/img/balm-mark.png" alt=""><span class="sr-only">Photo to come</span>{%- endif -%}
</div>
{%- endmacro %}

{% macro faqList(items) -%}
{% for f in items %}
<details class="faq"{% if loop.first %} open{% endif %}>
  <summary><span>{{ f.q }}</span>{{ icon("chevron", 20, "#0E6B62", 2.4) | safe }}</summary>
  <div class="answer">{{ f.a }}</div>
</details>
{% endfor %}
{%- endmacro %}

{% macro waLink(site, text) -%}{{ (text or site.whatsappMessage) | wa(site.whatsapp) }}{%- endmacro %}
