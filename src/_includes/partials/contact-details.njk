{% import "macros.njk" as m %}
<div class="info-list">
  <div class="row"><span class="ic">{{ m.icon("whatsapp", 22, "#0E6B62") | safe }}</span><div><div style="font-weight:600">WhatsApp and phone</div><a href="tel:{{ site.phoneLink }}">{{ site.phoneDisplay }}</a></div></div>
  <div class="row"><span class="ic">{{ m.icon("mail", 22, "#0E6B62") | safe }}</span><div><div style="font-weight:600">Email</div><a href="mailto:{{ site.email }}" style="overflow-wrap:anywhere">{{ site.email }}</a></div></div>
  <div class="row"><span class="ic">{{ m.icon("pin", 22, "#0E6B62") | safe }}</span><div><div style="font-weight:600">Visit us</div><div class="muted">{{ site.address }}<br>{{ site.city }}</div></div></div>
  <div class="row"><span class="ic">{{ m.icon("clock", 22, "#0E6B62") | safe }}</span><div><div style="font-weight:600">Opening hours</div><dl class="hours">{% for h in site.hours %}<dt>{{ h.days }}</dt><dd>{{ h.time }}</dd>{% endfor %}</dl></div></div>
</div>
